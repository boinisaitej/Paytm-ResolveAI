# ==============================================================================
# PAYTM RESOLVEAI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to backend/.env and supply your Azure environment values.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Application Settings
APP_NAME="Paytm ResolveAI"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Azure OpenAI Configuration (Only authorized LLM provider)
AZURE_OPENAI_ENDPOINT="https://<your-aoai-resource>.openai.azure.com/"
AZURE_OPENAI_API_KEY="<your-azure-openai-api-key>"
AZURE_OPENAI_CHAT_DEPLOYMENT="gpt-4o"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-large"
AZURE_OPENAI_API_VERSION="2024-06-01"

# Azure SQL Database Configuration (pyodbc / SQLAlchemy 2.0)
AZURE_SQL_SERVER="<your-sql-server>.database.windows.net"
AZURE_SQL_DATABASE="sqldb-paytm-resolveai"
AZURE_SQL_USER="paytmadmin"
AZURE_SQL_PASSWORD="<your-sql-admin-password>"
AZURE_SQL_DRIVER="ODBC Driver 18 for SQL Server"
AZURE_SQL_PORT=1433

# Azure AI Search (RAG Knowledge Base)
AZURE_SEARCH_ENDPOINT="https://<your-search-service>.search.windows.net"
AZURE_SEARCH_API_KEY="<your-search-api-key>"
AZURE_SEARCH_INDEX_NAME="paytm-knowledge-index"

# Azure Blob Storage (Policy & Audit Document Store)
AZURE_STORAGE_ACCOUNT="<your-storage-account>"
AZURE_STORAGE_KEY="<your-storage-key>"
AZURE_STORAGE_CONTAINER="knowledge-documents"

# Azure Telemetry & Observability
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=<guid>;IngestionEndpoint=https://..."
