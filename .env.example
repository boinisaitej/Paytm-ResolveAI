# ==============================================================================
# Paytm ResolveAI - Environment Configuration Template
# ==============================================================================

# Application Metadata
APP_NAME="Paytm ResolveAI"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="127.0.0.1"

# Azure OpenAI Service (Exclusive LLM Provider)
AZURE_OPENAI_ENDPOINT="https://<your-aoai-resource>.openai.azure.com/"
AZURE_OPENAI_API_KEY="<your-azure-openai-api-key>"
AZURE_OPENAI_CHAT_DEPLOYMENT="gpt-4o-mini"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-3-small"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# Azure AI Search (Knowledge Retrieval RAG)
AZURE_SEARCH_ENDPOINT="https://<your-search-resource>.search.windows.net"
AZURE_SEARCH_API_KEY="<your-azure-search-api-key>"
AZURE_SEARCH_INDEX_NAME="knowledge-documents-index"

# Azure Blob Storage (Document Lake)
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<your-storage>;AccountKey=<your-key>;EndpointSuffix=core.windows.net"
AZURE_STORAGE_CONTAINER_NAME="knowledge-documents"

# Database Configuration (PostgreSQL / Azure SQL)
DATABASE_URL="postgresql://paytm_admin:<password>@localhost:5432/paytm_resolveai"
